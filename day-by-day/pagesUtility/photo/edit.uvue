<template>
	<view class="photo-edit-page">
		<CustomNavBar title="编辑证件照" />

		<scroll-view class="edit-content" direction="vertical" :show-scrollbar="false">
			<!-- 预览区：左右并排 -->
			<view class="preview-area">
				<view class="preview-col">
					<text class="preview-label">原图</text>
					<view class="preview-frame">
						<image class="preview-img" :src="filePath" mode="aspectFit"></image>
						<view class="preview-badge"><text class="badge-text">{{ sizeState.name }}</text></view>
					</view>
				</view>
				<view class="preview-col">
					<text class="preview-label">效果预览</text>
					<!-- 核心：用 view + image，通过 CSS 实现换底+美颜近似 -->
					<view class="preview-frame">
						<view class="preview-content" v-if="cutoutSrc.length > 0" :style="{ 
								backgroundColor: colorState.hex,
								height: sizeState.customH + 'rpx',
								width: sizeState.customW + 'rpx'
								}">
							<image class="preview-img cutout-img" :src="cutoutSrc" mode="aspectFill"
								:style="previewFilterStyle"></image>
						</view>
						<view v-else class="loading-mask">
							<text class="loading-text">AI抠图中...</text>
						</view>
						<view class="preview-tip"
							v-if="beautyState.beautyOn && (beautyState.faceThin > 0 || beautyState.eyeEnlarge > 0)">
							<text class="tip-text">脸型调整以AI为准</text>
						</view>
					</view>
				</view>
			</view>

			<view class="edit-panel">
				<!-- 照片规格 -->
				<size-picker v-model="sizeState" />

				<!-- 快捷底色区 -->
				<color-picker v-model="colorState" />

				<!-- 智能美颜 -->
				<beauty-picker v-model="beautyState" />

				<!-- 智能换装 -->
				<clothing-picker v-model="suitState" @change="suitChange" />
			</view>

			<!-- 输出设置 -->
			<view class="edit-panel">
				<view class="panel-title">
					<svg-icon :svg="setupIcon" :size="26" color="#ED317F" />
					<text class="label-text">输出设置</text>
				</view>
				<view class="setting-row">
					<text class="setting-label">DPI 分辨率</text>
					<view class="dpi-chips">
						<view class="dpi-chip" :class="{ 'dpi-active': curDpi == 300 }" @click="curDpi = 300">
							<text class="dpi-text" :class="{ 'dpi-text-active': curDpi == 300 }">300</text>
						</view>
						<view class="dpi-chip" :class="{ 'dpi-active': curDpi == 350 }" @click="curDpi = 350">
							<text class="dpi-text" :class="{ 'dpi-text-active': curDpi == 350 }">350</text>
						</view>
						<view class="dpi-chip" :class="{ 'dpi-active': curDpi == 600 }" @click="curDpi = 600">
							<text class="dpi-text" :class="{ 'dpi-text-active': curDpi == 600 }">600</text>
						</view>
					</view>
				</view>
				<view class="setting-row">
					<text class="setting-label">文件格式</text>
					<view class="dpi-chips">
						<view class="dpi-chip" :class="{ 'dpi-active': curFmt == 'jpg' }" @click="curFmt = 'jpg'">
							<text class="dpi-text" :class="{ 'dpi-text-active': curFmt == 'jpg' }">JPG</text>
						</view>
						<view class="dpi-chip" :class="{ 'dpi-active': curFmt == 'png' }" @click="curFmt = 'png'">
							<text class="dpi-text" :class="{ 'dpi-text-active': curFmt == 'png' }">PNG</text>
						</view>
					</view>
				</view>
			</view>

			<view style="height: 180rpx;"></view>
		</scroll-view>

		<view class="bottom-bar">
			<view class="submit-btn" :class="{ 'submit-disabled': busy }" @click="submit">
				<text class="submit-text">{{ busy ? '处理中...' : '✨ 开始制作' }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch } from 'vue'

	import { preview, changeSuit, process } from '@/api/idPhotoApi'
	import { isSuccess } from '@/utils/request.uts';
	import { get, upload } from '@/utils/request.uts'
	import { getToken } from '@/utils/auth.uts'
	import { setupIcon } from '@/utils/svg/nestSvg';

	import SvgIcon from '@/components/SvgIcon.uvue'
	import CustomNavBar from '@/components/CustomNavBar.uvue'
	import SizePicker from './components/sizePicker.uvue'
	import ColorPicker from './components/colorPicker.uvue'
	import BeautyPicker from './components/beautyPicker.uvue'
	import ClothingPicker from './components/clothingPicker.uvue'


	import { SizeItem, SizeState, ColorState, BeautyState, SuitState } from '@/types/photoType';

	const filePath = ref('')
	// 新增：存储后端返回的透明底抠图路径
	const cutoutSrc = ref('')

	const sizeState = ref({ code: 'one_inch', name: '一寸', customW: '295', customH: '413' } as SizeState)
	const colorState = ref({ hex: '#FFFFFF', name: '白底', customHex: '' } as ColorState)

	const beautyState = ref({ beautyOn: false, skinSmooth: 0, skinWhiten: 5, faceThin: 0, eyeEnlarge: 0 } as BeautyState)

	const suitState = ref({ suitOn: false, selSuitId: -1, url: '' } as SuitState)

	const curDpi = ref(300)
	const curFmt = ref('jpg')
	const busy = ref(false)

	const previewId = ref(0)

	// 核心：用 computed 生成 CSS filter 字符串
	const previewFilterStyle = computed(() : UTSJSONObject => {
		if (!beautyState.value.beautyOn) return {} as UTSJSONObject

		const brightness = 1 + (beautyState.value.skinWhiten / 200)
		const contrast = 1 + (beautyState.value.skinWhiten / 400)
		const blur = beautyState.value.skinSmooth / 20

		let filterVal = 'brightness(' + brightness.toString() + ') contrast(' + contrast.toString() + ')'
		if (blur > 0) {
			filterVal += ' blur(' + blur.toString() + 'px)'
		}

		return { filter: filterVal } as UTSJSONObject
	})

	// 进入页面时自动获取透明底抠图（仅抠图，不调美颜/换装，成本极低）
	const fetchCutout = async () => {
		if (filePath.value.length == 0) return
		const res = await preview(filePath.value, 'id-photo', '3');
		if (res.code == 200 && res.data != null) {
			const data = res.data as UTSJSONObject
			const url = data['url']
			if (url != null) {
				cutoutSrc.value = url as string
				previewId.value = data['id'] as number
			}
		}
	}

	const suitChange = async (item : SuitState) => {
		console.log(item, 123);
		if (item.selSuitId < 0)
			return;
		const params : UTSJSONObject = {
			id: previewId.value,
			suitId: item.selSuitId
		}
		const res = await changeSuit(params);
		if (res.code == 200 && res.data != null) {
			const data = res.data as UTSJSONObject
			const url = data['url']
			if (url != null) {
				cutoutSrc.value = url as string
			}
		}
	}

	const submit = async () => {
		if (busy.value) return
		if (getToken().length == 0) { uni.showToast({ title: '请先登录', icon: 'none' }); return }
		if (suitState.value.suitOn && suitState.value.selSuitId < 0) { uni.showToast({ title: '请选择一套服装', icon: 'none' }); return }

		busy.value = true
		const params : UTSJSONObject = {
			width: sizeState.value.customW,
			height: sizeState.value.customH,
			bgColor: colorState.value.hex,
			bgColorName: colorState.value.name,
			format: curFmt.value, dpi: '' + curDpi.value,
			beautyEnable: beautyState.value.beautyOn ? '1' : '0',
			skinSmooth: '' + beautyState.value.skinSmooth,
			skinWhiten: '' + beautyState.value.skinWhiten,
			faceThin: '' + beautyState.value.faceThin,
			eyeEnlarge: '' + beautyState.value.eyeEnlarge,
			suitEnable: (suitState.value.suitOn && suitState.value.selSuitId >= 0) ? '1' : '0',
			suitId: '' + suitState.value.selSuitId,
			previewId: previewId.value
		}

		if (sizeState.value.code == 'custom') {
			params['widthPx'] = sizeState.value.customW
			params['heightPx'] = sizeState.value.customH
		}

		uni.showLoading({ title: 'AI处理中...' })
		const res = await process(params);
		uni.hideLoading();
		busy.value = false
		// uni.uploadFile({
		// 	url: '/photo/process',
		// 	filePath: filePath.value,
		// 	name: 'file',
		// 	formData: fd,
		// 	header: { 'Authorization': 'Bearer ' + getToken() },
		// 	success: (res) => {
		// 		uni.hideLoading(); busy.value = false
		// 		const d = JSON.parse(res.data) as UTSJSONObject
		// 		const code = d['code']
		// 		if (code != null && (code as number) == 200) {
		// 			const rec = d['data'] as UTSJSONObject
		// 			const recId = rec['id']
		// 			if (recId != null) {
		// 				uni.redirectTo({ url: '/pages/result/result?id=' + (recId as number) })
		// 			}
		// 		} else {
		// 			const msg = d['msg']
		// 			uni.showToast({ title: (msg != null ? msg as string : '处理失败'), icon: 'none' })
		// 		}
		// 	},
		// 	fail: () => {
		// 		uni.hideLoading(); busy.value = false
		// 		uni.showToast({ title: '网络错误', icon: 'none' })
		// 	}
		// })


	}

	onLoad((options : OnLoadOptions) => {
		const fp = options['fp']
		if (fp != null) filePath.value = decodeURIComponent(fp as string) ?? ''

		const sc = options['sc']
		if (sc != null) sizeState.value.code = sc as string

		const bc = options['bc']
		if (bc != null) {
			colorState.value.hex = bc as string
			const bn = options['bn']
			colorState.value.name = (bn != null ? bn as string : '自定义')
		}

		// 自动获取透明底用于右侧预览
		fetchCutout()
	})
</script>

<style lang="scss">
	.photo-edit-page {
		min-height: 100vh;
		background-color: #F7F8FA;

		.edit-content {
			min-height: 100vh;

			.preview-area {
				display: flex;
				flex-direction: row;
				justify-content: center;
				gap: 20rpx;
				padding: 30rpx 20rpx 10rpx;

				.preview-col {
					display: flex;
					flex-direction: column;
					align-items: center;
				}

				.preview-label {
					font-size: 24rpx;
					color: $text-sub;
					margin-bottom: 12rpx;
					font-weight: 600;
				}

				.preview-frame {
					width: 320rpx;
					height: 440rpx;
					border-radius: $radius-md;
					overflow: hidden;
					box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
					position: relative;
					border: 3rpx solid #fff;
					display: flex;
					justify-content: center;
					align-items: center;

					.preview-content {
						position: relative;
					}

					.preview-img {
						width: 100%;
						height: 100%;

						&.cutout-img {
							transition: filter 0.15s ease;
						}
					}

					.preview-badge {
						position: absolute;
						top: 12rpx;
						right: 12rpx;
						background-color: rgba($primary, 0.92);
						border-radius: 12rpx;
						padding: 4rpx 14rpx;

						.badge-text {
							font-size: 20rpx;
							color: #fff;
							font-weight: 600;
						}
					}

					// 抠图图片需要支持 CSS filter
					.loading-mask {
						width: 320rpx;
						height: 440rpx;
						display: flex;
						align-items: center;
						justify-content: center;
						background-color: #f0f0f5;

						.loading-text {
							font-size: 24rpx;
							color: $text-hint;
						}
					}

					.preview-tip {
						position: absolute;
						bottom: 12rpx;
						left: 0;
						right: 0;
						background-color: rgba(0, 0, 0, 0.6);
						padding: 6rpx 0;

						.tip-text {
							font-size: 20rpx;
							color: #fff;
							text-align: center;
						}
					}
				}

			}

			.edit-panel {
				padding: 28rpx 30rpx 12rpx;

				.panel-title {
					font-size: 30rpx;
					font-weight: 700;
					color: #1A1A2E;
					display: flex;
					flex-direction: row;
					align-items: center;

					.label-text {
						margin-left: 10rpx;
					}
				}

				.setting-row {
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: space-between;
					margin-top: 20rpx;

					.setting-label {
						font-size: 27rpx;
						color: $text-sub;
					}

					.dpi-chips {
						display: flex;
						flex-direction: row;
						gap: 14rpx;

						.dpi-chip {
							background-color: #fff;
							border: 2rpx solid $border;
							border-radius: 12rpx;
							padding: 12rpx 28rpx;

							&.dpi-active {
								background-color: $primary-bg;
								border-color: $primary;
							}

							.dpi-text {
								font-size: 26rpx;
								color: $text-sub;

								&.dpi-text-active {
									color: $primary;
									font-weight: 600;
								}
							}

						}
					}
				}
			}
		}

		.bottom-bar {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			padding: 20rpx 30rpx 40rpx;
			background-color: #fff;
			box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);

			.submit-btn {
				background-image: $gradient-primary;
				border-radius: $radius-full;
				padding: 30rpx;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: $shadow-btn;

				&.submit-disabled {
					opacity: 0.6;
				}

				.submit-text {
					font-size: 34rpx;
					font-weight: 700;
					color: #fff;
				}
			}
		}
	}
</style>