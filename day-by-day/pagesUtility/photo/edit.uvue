	.dpi-chip {
		background-color: #fff;
		border: 2rpx solid $border;
		border-radius: 12rpx;
		padding: 12rpx 28rpx;
	}

	.dpi-active {
		background-color: $primary-bg;
		border-color: $primary;
	}

	.dpi-text {
		font-size: 26rpx;
		color: $text-sub;
	}

