<template>
  <view class="page">
    <!-- 极简导航栏 -->
    <view class="navbar" :style="{ paddingTop: statusBarH + 'px' }">
      <view class="navbar-inner">
        <text class="navbar-title">智能证件照</text>
        <view class="nav-btn" @click="goHistory">
          <text class="nav-btn-text">📋 记录</text>
        </view>
      </view>
    </view>

    <scroll-view class="content" :style="{ paddingTop: (statusBarH + 44) + 'px' }" direction="vertical" :show-scrollbar="false">
      <!-- 主操作卡片 -->
      <view class="main-card">
        <view class="card-header">
          <text class="card-title">制作证件照</text>
          <text class="card-subtitle">选择规格后拍摄或导入照片</text>
        </view>

        <!-- 尺寸选择 -->
        <view class="field-group">
          <text class="field-label">照片规格</text>
          <scroll-view class="size-scroll" direction="horizontal" :show-scrollbar="false">
            <view class="size-list">
              <view
                class="size-tag"
                :class="{ 'size-tag-active': curSizeCode == (s['code'] as string) }"
                v-for="(s, idx) in sizes"
                :key="idx"
                @click="selSize(s)"
              >
                <text class="size-tag-text" :class="{ 'size-tag-text-active': curSizeCode == (s['code'] as string) }">{{ s['name'] }}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 快捷底色 -->
        <view class="field-group">
          <text class="field-label">快捷底色 <text class="field-hint">(可选)</text></text>
          <view class="color-row">
            <view
              class="color-dot-wrap"
              v-for="(c, idx) in colors"
              :key="idx"
              @click="selQuickColor(c)"
            >
              <view
                class="color-dot"
                :class="{ 'color-dot-active': quickBgHex == (c['hex'] as string) }"
                :style="{ backgroundColor: c['hex'] as string }"
              ></view>
            </view>
            <view class="color-dot-wrap" @click="clearQuickColor">
              <view class="color-dot color-dot-reset">
                <text class="reset-icon">✕</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="action-area">
          <view class="btn-primary" @click="pick('camera')">
            <text class="btn-primary-icon">📷</text>
            <text class="btn-primary-text">拍摄照片</text>
          </view>
          <view class="btn-secondary" @click="pick('album')">
            <text class="btn-secondary-text">从相册选择</text>
          </view>
        </view>
      </view>

      <!-- 拍摄贴士 -->
      <view class="tips-section">
        <text class="tips-title">拍摄小贴士</text>
        <view class="tips-grid">
          <view class="tip-item">
            <text class="tip-icon">✅</text>
            <text class="tip-text">正面平视镜头</text>
          </view>
          <view class="tip-item">
            <text class="tip-icon">✅</text>
            <text class="tip-text">光线均匀充足</text>
          </view>
          <view class="tip-item">
            <text class="tip-icon">❌</text>
            <text class="tip-text">避免过度仰拍</text>
          </view>
          <view class="tip-item">
            <text class="tip-icon">❌</text>
            <text class="tip-text">避免复杂背景</text>
          </view>
        </view>
      </view>

      <view style="height: 60rpx;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { get } from '@/utils/request.uts'

type SizeItem = { name: string; code: string }

const statusBarH = ref(0)
const sizes = ref([] as UTSJSONObject[])
const curSizeCode = ref('one_inch')
const quickBgHex = ref('')
const quickBgName = ref('')

const colors = ref([
  { name: '白底', hex: '#FFFFFF' },
  { name: '蓝底', hex: '#438EDB' },
  { name: '红底', hex: '#FF0000' },
  { name: '浅蓝', hex: '#73B8EA' },
  { name: '渐变蓝', hex: '#4A90D9' },
  { name: '灰底', hex: '#CCCCCC' }
] as UTSJSONObject[])

function loadSizes() {
  get<SizeItem[]>('/config/sizes').then((res) => {
    if (res.code == 200 && res.data != null) {
      const arr = res.data as SizeItem[]
      const list: UTSJSONObject[] = []
      for (let i = 0; i < arr.length; i++) {
        list.push({ name: arr[i].name, code: arr[i].code } as UTSJSONObject)
      }
      sizes.value = list
    }
  }).catch((_e: any | null) => {})
}

function selSize(s: UTSJSONObject) {
  curSizeCode.value = s['code'] as string
}

function selQuickColor(c: UTSJSONObject) {
  quickBgHex.value = c['hex'] as string
  quickBgName.value = c['name'] as string
}

function clearQuickColor() {
  quickBgHex.value = ''
  quickBgName.value = ''
}

function pick(src: string) {
  uni.chooseImage({
    count: 1,
    sourceType: [src],
    sizeType: ['original'],
    success: (res) => {
      let url = '/pages/edit/edit?fp=' + encodeURIComponent(res.tempFilePaths[0])
      url += '&sc=' + curSizeCode.value
      if (quickBgHex.value.length > 0) {
        url += '&bc=' + quickBgHex.value + '&bn=' + quickBgName.value
      }
      uni.navigateTo({ url })
    },
    fail: (_e) => {}
  } as ChooseImageOptions)
}

function goHistory() {
  uni.navigateTo({ url: '/pages/history/history' })
}

onLoad((_options: OnLoadOptions) => {
  statusBarH.value = uni.getSystemInfoSync().statusBarHeight ?? 0
  loadSizes()
})
</script>

<style lang="scss">
