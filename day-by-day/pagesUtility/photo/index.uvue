<template>
	<view class="photo-page">
		<!-- 引用公共导航栏组件 -->
		<CustomNavBar title="智能证件照">
			<template #right>
				<view class="photo-nav-btn" @click="goHistory">
					<svg-icon :svg="recordIcon" :size="22" color="#ffffff" />
				</view>
			</template>
		</CustomNavBar>

		<scroll-view class="photo-content" direction="vertical" :show-scrollbar="false">
			<!-- 核心操作卡片 -->
			<view class="main-card">
				<view class="card-header">
					<text class="card-title">制作证件照</text>
					<text class="card-subtitle">选择规格后拍摄或导入照片</text>
				</view>

				<!-- 照片规格 -->
				<size-picker v-model="sizeState" @change="onSizeChange" />
				<!-- 快捷底色区 -->
				<color-picker v-model="colorState" @change="onColorChange" />

				<!-- 触发按钮组 -->
				<view class="action-area">
					<view class="btn-primary" @click="pick('camera')">
						<text class="btn-primary-icon">
							<svg-icon :svg="cameraIcon" :size="22" color="#ffffff" />
						</text>
						<text class="btn-primary-text">立即拍摄</text>
					</view>
					<view class="btn-secondary" @click="pick('album')">
						<text class="btn-secondary-text">从相册导入</text>
					</view>
				</view>
			</view>

			<!-- 拍摄贴士卡片 -->
			<view class="tips-card">
				<view class="tips-title">
					<svg-icon :svg="remindIcon" :size="26" color="#ED317F" />
					<text class="label-text">拍摄小贴士</text>
				</view>
				<view class="tips-grid">
					<view class="tip-item">
						<text class="tip-icon">✅</text>
						<text class="tip-text">正面平视镜头</text>
					</view>
					<view class="tip-item">
						<text class="tip-icon">✅</text>
						<text class="tip-text">光线均匀充足</text>
					</view>
					<view class="tip-item">
						<text class="tip-icon">❌</text>
						<text class="tip-text">避免过度仰拍</text>
					</view>
					<view class="tip-item">
						<text class="tip-icon">❌</text>
						<text class="tip-text">避免复杂背景</text>
					</view>
				</view>
			</view>

			<view style="height: 60rpx;"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	import CustomNavBar from '@/components/CustomNavBar.uvue'
	import SvgIcon from '@/components/SvgIcon.uvue'
	import SizePicker from './components/sizePicker.uvue'
	import ColorPicker from './components/colorPicker.uvue'

	import { getSizes } from '@/api/idPhotoApi'
	import { SizeItem, SizeState, ColorState } from '@/types/photoType';
	import { isSuccess } from '@/utils/request.uts';
	import { recordIcon, cameraIcon, remindIcon } from '@/utils/svg/photoSvg';

	const sizeState = ref({ code: 'one_inch', name: '一寸', customW: '295', customH: '413' } as SizeState)
	const colorState = ref({ hex: '#FFFFFF', name: '白底', customHex: '' } as ColorState)

	const onSizeChange = (_s : SizeState) => {
		// sizeState 已通过 v-model 自动同步
	}
	const onColorChange = (_c : ColorState) => {
		// colorState 已通过 v-model 自动同步
	}

	function pick(src : string) {
		uni.chooseImage({
			count: 1,
			sourceType: [src],
			sizeType: ['original'],
			success: (res) => {
				let url = '/pagesUtility/photo/edit?fp=' + encodeURIComponent(res.tempFilePaths[0])
				url += '&sc=' + sizeState.value.code
				if (colorState.value.hex.length > 0) {
					url += '&bc=' + colorState.value.hex + '&bn=' + colorState.value.name
				}
				uni.navigateTo({ url })
			},
			fail: (_e) => { }
		} as ChooseImageOptions)
	}

	function goHistory() {
		uni.navigateTo({ url: '/pagesUtility/photo/history' })
	}

	onLoad((_options : OnLoadOptions) => {
	})
</script>

<style lang="scss">
	.photo-page {
		min-height: 100vh;
		background-color: #F7F8FA;
	}

	/* ====== 导航栏右侧按钮样式 ====== */
	.photo-nav-btn {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 15px;
		border-radius: 24rpx;
		background-color: rgba(0, 0, 0, 0.04);
	}

	.nav-btn-text {
		font-size: 24rpx;
		color: #ffffff;
		font-weight: 500;
	}

	/* ====== 内容区 ====== */
	.photo-content {
		min-height: 100vh;

		/* ====== 主操作卡片 ====== */
		.main-card {
			margin: 20rpx 24rpx 0;
			background-color: #FFFFFF;
			border-radius: 28rpx;
			padding: 36rpx 32rpx 32rpx;
			box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);

			.card-header {
				margin-bottom: 36rpx;

				.card-title {
					font-size: 38rpx;
					font-weight: 800;
					color: #1A1A1A;
					display: block;
					margin-bottom: 10rpx;
					letter-spacing: 0.5px;
				}

				.card-subtitle {
					font-size: 24rpx;
					color: #999;
					display: block;
				}
			}

			/* ====== 操作按钮 ====== */
			.action-area {
				display: flex;
				flex-direction: column;
				gap: 20rpx;
				margin-top: 12rpx;
			}

			.btn-primary {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				gap: 12rpx;
				height: 100rpx;
				border-radius: 50rpx;
				background-color: #ED317F;
				box-shadow: 0 8rpx 24rpx rgba(#ED317F, 0.25);

				.btn-primary-icon {
					font-size: 34rpx;
				}

				.btn-primary-text {
					font-size: 32rpx;
					font-weight: 700;
					color: #FFFFFF;
					letter-spacing: 1px;
				}
			}

			.btn-secondary {
				display: flex;
				align-items: center;
				justify-content: center;
				height: 92rpx;
				border-radius: 46rpx;
				background-color: #F5F6FA;

				.btn-secondary-text {
					font-size: 28rpx;
					font-weight: 600;
					color: #555;
				}
			}
		}

		/* ====== 贴士卡片 ====== */
		.tips-card {
			margin: 20rpx 24rpx 0;
			background-color: #FFFFFF;
			border-radius: 28rpx;
			padding: 28rpx 32rpx;
			box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);

			.tips-title {
				font-size: 28rpx;
				font-weight: 700;
				color: #333;
				display: block;
				margin-bottom: 20rpx;
				display: flex;
				flex-direction: row;
				align-items: center;

				.label-text {
					margin-left: 10rpx;
				}
			}

			.tips-grid {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				gap: 16rpx;

				.tip-item {
					width: calc(50% - 8rpx);
					display: flex;
					flex-direction: row;
					align-items: center;
					gap: 10rpx;
					background-color: #FAFBFC;
					border-radius: 16rpx;
					padding: 18rpx 20rpx;

					.tip-icon {
						font-size: 26rpx;
					}

					.tip-text {
						font-size: 24rpx;
						color: #666;
					}
				}
			}
		}
	}
</style>