<template>
	<view class="common-flex-body">
		<!-- 轮播图 -->
		<view class="kitchen-carousel">
			<swiper class="kitchen-swiper" autoplay interval="3000" circular>
				<swiper-item item-id="A">
					<image class="carousel-img"
						:src="encodeURI('https://joyimg.lexujia.com/day-by-day/2026-06-02_161859_797.jpg')"></image>
				</swiper-item>
				<swiper-item item-id="B">
					<image class="carousel-img"
						:src="encodeURI('https://joyimg.lexujia.com/day-by-day/2026-06-02_161922_203.jpg')"></image>
				</swiper-item>
			</swiper>
		</view>
		<view class="kitchen-header">
			<!-- 顶部 -->
			<view class="header-section">
				<view class="header-info">
					<image src="/static/img/logo.jpg" class="avatar"></image>
					<view class="info-content">
						<view class="title-row">
							<text class="tag">Lv.1</text>
							<text class="name">朝夕小厨房</text>
						</view>
						<text class="people-count">共2人</text>
					</view>
				</view>
				<text class="notice-text">公告：家是爱的地方，好好生活，好好吃饭，好好爱老婆，照顾好77。</text>
			</view>
			<!-- 搜索导航栏 -->
			<view class="header-bar" @click="handleBarClick">
				<text class="header-title" :class="{ 'active': !isSearch }" @click.stop="cancelSearch">
					点单
				</text>
				<view class="search-box" :class="{ 'active': isSearch }">
					<input class="search-input" v-model="keyword" :focus="isSearch" placeholder="请输入菜名"
						confirm-type="search" :adjust-position="false" @confirm="performSearch" @blur="handleBlur"
						@click.stop />
					<view class="search-icon" @click.stop="handleSearchClick">
						<svg-icon :svg="searchIcon" :size="24" />
					</view>
					<text class="search-placeholder" :class="{ 'hidden': isSearch || keyword.length > 0 }"
						@click.stop="toogleSearch">
						搜索
					</text>
				</view>
			</view>
		</view>

		<!-- 3. 主体内容区 (flex:1 占据剩余空间) -->
		<view class="kitchen-body">
			<!-- 左侧分类菜单 -->
			<scroll-view class="left-menu" scroll-y="true">
				<view v-for="(item, index) in categories" :key="index" class="menu-item"
					:class="{ 'active': currentCategoryIndex === index }" @click="switchCategory(index)">
					<text class="menu-text">{{ item }}</text>
				</view>
			</scroll-view>

			<!-- 右侧菜品列表 -->
			<scroll-view class="right-list" scroll-y="true" :scroll-into-view="scrollViewId">
				<view v-for="(cat, index) in categories" :key="index" :id="'cat-' + index" class="category-block">
					<view class="category-header">
						<text class="cat-title">{{ cat }}</text>
						<text class="cat-count">(68)</text>
					</view>

					<!-- 单个菜品卡片 -->
					<view class="food-card" v-for="(food, fIndex) in 5" :key="fIndex">
						<image src="/static/img/logo.jpg" class="food-img" mode="aspectFill"></image>
						<view class="food-info">
							<text class="food-name">酸菜炒大肠</text>
							<text class="food-desc">肥肠、酸菜、姜、干辣椒...</text>
							<view class="sales-row">
								<text class="sales-text">月销 0</text>
							</view>
						</view>
						<view class="add-btn">+</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<view class="kitchen-cart">
			<view class="cart-main">
				<view class="cart-icon">
					<svg-icon :svg="shopCardIcon" :size="30" color="#ED317F" />
				</view>
				<view class="random-food">随机选菜</view>
				<view class="invite-btn">邀请下单</view>
				<view class="order-btn">下单</view>
			</view>
		</view>

	</view>
</template>

<script setup lang="uts">
	import { ref, nextTick } from 'vue'

	import SvgIcon from '@/components/SvgIcon.uvue'

	import { shopCardIcon } from '@/utils/svg/kitchenSvg'
	import { searchIcon } from '@/utils/svg/commonSvg'

	const scrollViewId = ref("")
	const currentCategoryIndex = ref(0)
	const categories = ref(['无肉不欢', '靓汤', '青菜', '主食', '饮料', '水果', '甜点', '套餐'])

	const switchCategory = (index : number) => {
		// 更新响应式数据，这会自动触发视图更新
		currentCategoryIndex.value = index
		scrollViewId.value = 'cat-' + index

		// 如果需要，可以在这里添加其他逻辑
		console.log('切换到分类:', categories.value[index])
	}

	const isSearch = ref(false)
	const keyword = ref<string>('')
	const isFocusing = ref<boolean>(false)

	const handleBarClick = () : void => {
		// 如果当前处于搜索状态，则关闭搜索框并收起键盘
		if (isSearch.value && !isFocusing.value) {
			cancelSearch()
		}
	}

	const toogleSearch = () => {
		if (isSearch.value) return

		// 1. 先标记正在聚焦，阻止 blur 立即关闭
		isFocusing.value = true

		// 2. 等待 DOM 更新后，强制调用 focus
		// 这是解决小程序首次聚焦不稳定的最有效手段
		nextTick(() => {

			isSearch.value = true
			// 3. 延迟重置标记，允许后续的 normal blur 生效
			setTimeout(() => {
				isFocusing.value = false
			}, 500)
		})

	}

	/**
	 * 搜索图标点击事件
	 * 逻辑分流
	 */
	const handleSearchClick = () => {
		if (!isSearch.value) {
			// 状态为 false，点击则展开搜索框
			toogleSearch()
		} else {
			// 状态为 true，点击则执行搜索逻辑
			performSearch()
		}
	}

	/**
	 * 实际搜索业务逻辑
	 */
	const performSearch = () => {
		if (!keyword.value.trim()) {
			uni.showToast({ title: '请输入内容', icon: 'none' })
			return
		}
		console.log('搜索:', keyword.value)

		uni.showToast({ title: `搜索: ${keyword.value}`, icon: 'none' })
		cancelSearch()
	}

	/**
	 * 输入框失去焦点处理
	 * 策略：如果输入框为空，则自动收起搜索栏
	 */
	const handleBlur = () => {
		// 如果正在聚焦过程中，忽略此次 blur
		if (isFocusing.value) {
			return
		}

		// 延迟判断，防止点击搜索按钮时先 blur 后 click 导致的冲突
		setTimeout(() => {
			if (isSearch.value && !keyword.value) {
				cancelSearch()
			}
		}, 100)
	}

	/**
	 * 点击标题取消搜索
	 */
	const cancelSearch = () => {
		isSearch.value = false
		uni.hideKeyboard()
		keyword.value = ''
	}
</script>

<style lang="scss">
	.common-flex-body {
		padding-top: 300rpx;
		background-color: $unify-white;
		.kitchen-carousel {
			width: 100%;
			height: 350rpx;
			z-index: 1;
			position: absolute;
			top: 0;

			.kitchen-swiper {
				width: 100%;
				height: 350rpx;
			}

			.carousel-img {
				width: 100%;
				height: 350rpx;
			}
		}

		.kitchen-header {
			z-index: 2;
			border-top-right-radius: 30rpx;
			border-top-left-radius: 30rpx;
			position: relative;

			.header-section {
				padding: 20rpx 30rpx;
				background-color: $unify-white;
				border-bottom: 1rpx solid $border-color-grey;

				.header-info {
					display: flex;
					flex-direction: row;
					align-items: center;

					.avatar {
						width: 100rpx;
						height: 100rpx;
						border-radius: 10rpx;
						background-color: $bg-color-grey;
						/* 占位色 */
						margin-right: 20rpx;
					}

					.info-content {
						display: flex;
						flex-direction: column;

						.title-row {
							display: flex;
							flex-direction: row;
							align-items: center;
							margin-bottom: 10rpx;

							.tag {
								background-color: $select-color;
								color: #fff;
								font-size: 20rpx;
								padding: 4rpx 8rpx;
								border-radius: 6rpx;
								margin-right: 10rpx;
							}

							.shop-name {
								font-size: 32rpx;
								font-weight: bold;
								color: $unify-black;
							}
						}

						.count {
							font-size: 24rpx;
							color: $unify-white;
						}
					}
				}

				.notice-text {
					font-size: 24rpx;
					color: $unify-grey;
					margin-top: 15rpx;
					lines: 1;
					/* 单行省略 */
					// text-overflow: ellipsis;
					// white-space: nowrap;
					// overflow: hidden;
				}
			}

			/* --- 导航栏 --- */
			.header-bar {
				display: flex;
				flex-direction: row;
				justify-content: space-between;
				align-items: center;
				padding: 20rpx 30rpx;
				background-color: $unify-white;

				.header-title {
					font-size: 32rpx;
					font-weight: bold;
					position: relative;
				}

				&.active::after {
					content: '';
					position: absolute;
					bottom: -10rpx;
					left: 0;
					width: 100%;
					height: 6rpx;
					background-color: $unify-black;
					border-radius: 3rpx;
				}
			}

			.search-box {
				display: flex;
				flex-direction: row;
				align-items: center;
				background-color: $bg-color-grey;
				padding: 10rpx 20rpx;
				border-radius: 30rpx;
				width: 200rpx;

				.search-input {
					display: none;
				}

				.search-icon {
					font-size: 24rpx;
					margin-right: 10rpx;
					color: $unify-white;
				}

				.search-placeholder {
					font-size: 24rpx;
					color: $unify-grey;
				}

				&.active {
					width: 450rpx;

					.search-input {
						display: block;
						width: 360rpx;
					}

					.search-placeholder {
						display: none;
					}
				}
			}

		}

		/* --- 主体内容区 (核心修复部分) --- */
		.kitchen-body {
			flex: 1;
			/* 占据剩余所有高度 */
			display: flex;
			/* 内部开启 flex 布局 */
			flex-direction: row;
			height: 0;
			/* 关键：配合 flex:1 强制限制高度，触发内部滚动 */
			overflow: hidden;


			/* 左侧菜单 */
			.left-menu {
				width: 180rpx;
				height: 100%;
				/* 必须显式设置高度 */
				background-color: $bg-un-color;

				.menu-item {
					height: 100rpx;
					display: flex;
					align-items: center;
					justify-content: center;
					background-color: $bg-un-color;

					&.active {
						background-color: $unify-white;
						font-weight: bold;
						position: relative;

						.menu-text {
							color: $unify-black;
						}
					}

					&.active::before {
						content: '';
						position: absolute;
						left: 0;
						top: 30rpx;
						bottom: 30rpx;
						width: 8rpx;
						background-color: $unify-black;
						border-radius: 0 4rpx 4rpx 0;
					}

					.menu-text {
						font-size: 28rpx;
						color: $unify-grey;
					}

				}

			}

			/* 右侧列表 */
			.right-list {
				flex: 1;
				/* 占据剩余宽度 */
				height: 100%;
				/* 必须显式设置高度 */
				background-color: $unify-white;
				padding-left: 20rpx;
				box-sizing: border-box;

				.category-block {
					margin-bottom: 30rpx;
					padding-bottom: 90rpx;
					

					.category-header {
						padding: 20rpx 0;
						display: flex;
						flex-direction: row;
						align-items: baseline;

						.cat-title {
							font-size: 30rpx;
							font-weight: bold;
							color: $unify-black;
							margin-right: 10rpx;
						}

						.cat-count {
							font-size: 24rpx;
							color: $unify-white;
						}
					}

					.food-card {
						display: flex;
						flex-direction: row;
						margin-bottom: 30rpx;
						padding-right: 20rpx;

						.food-img {
							width: 180rpx;
							height: 180rpx;
							border-radius: 10rpx;
							background-color: $bg-color-grey;
							margin-right: 20rpx;
						}

						.food-info {
							flex: 1;
							display: flex;
							flex-direction: column;
							justify-content: space-between;
							padding-top: 10rpx;

							.food-name {
								font-size: 30rpx;
								font-weight: bold;
								color: $unify-black;
							}

							.food-desc {
								font-size: 22rpx;
								color: $unify-white;
								margin-top: 10rpx;
								lines: 2;
							}

							.sales-text {
								font-size: 22rpx;
								color: $unify-white;
							}
						}

						.add-btn {
							width: 50rpx;
							height: 50rpx;
							border-radius: 50%;
							background-color: $bg-color-grey;
							color: #fff;
							text-align: center;
							line-height: 50rpx;
							align-self: flex-end;
							font-size: 30rpx;
						}
					}
				}
			}

		}

		.kitchen-cart {
			position: fixed;
			/* #ifdef H5 */
			bottom: 130rpx;
			/* #endif */
			/* #ifndef H5 */
			bottom: 20rpx;
			/* #endif */
			right: 50rpx;
			left: 50rpx;
			padding: 15rpx;
			z-index: 9;
			border-radius: 50rpx;
			box-shadow: $shadow-color-black;
			background-color: $shadow-color-black;

			.cart-main {
				display: flex;
				flex-direction: row;
				align-items: center;
				gap: 24rpx;
				font-size: 24rpx;

				.cart-icon {
					flex-shrink: 0;
				}

				.random-food {
					margin-left: auto;
					color: $select-color;
					flex-shrink: 0;
				}

				.invite-btn {
					padding: 10rpx 25rpx;
					border: 1px solid $select-color;
					border-radius: 25rpx;
					color: $select-color;
					background-color: $unify-white;
					flex-shrink: 0;
				}

				.order-btn {
					padding: 10rpx 25rpx;
					border-radius: 25rpx;
					color: $unify-grey;
					background-color: $bg-color-grey;
					flex-shrink: 0;
				}
			}
		}
	}
</style>