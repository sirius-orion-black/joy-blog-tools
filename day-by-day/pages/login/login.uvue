<template>
	<view class="login-page">
		<!-- ====== 背景装饰层 ====== -->
		<view class="bg-layer">
			<view class="bg-gradient"></view>
			<view class="orb orb-1"></view>
			<view class="orb orb-2"></view>
			<view class="orb orb-3"></view>
		</view>

		<!-- ====== Logo 区域 ====== -->
		<view class="logo-section">
			<view class="logo-circle">
				<text class="logo-emoji">📅</text>
			</view>
			<text class="app-title">MySchedule</text>
			<text class="app-subtitle">让每一天都井然有序</text>
		</view>

		<!-- ====== 主卡片 ====== -->
		<view class="glass-card">
			<!-- Tab 切换器 -->
			<view class="tab-bar">
				<view class="tab-track">
					<view class="tab-indicator" :style="{ left: mode === 'login' ? '0%' : '50%' }"></view>
				</view>
				<view class="tab-item" @click="switchMode('login')">
					<text class="tab-label" :class="{ 'tab-label-active': mode === 'login' }">登录</text>
				</view>
				<view class="tab-item" @click="switchMode('register')">
					<text class="tab-label" :class="{ 'tab-label-active': mode === 'register' }">注册</text>
				</view>
			</view>

			<!-- 手机号 -->
			<view class="field-wrap" :class="{ 'field-focus': focusField === 'phone' }">
				<view class="field-icon-box" :class="{ 'icon-active': focusField === 'phone' }">
					<text class="field-icon">📱</text>
				</view>
				<input class="field-input" type="number" maxlength="11" placeholder="手机号码"
					placeholder-class="field-placeholder" v-model="formData.phone" @focus="focusField = 'phone'"
					@blur="focusField = ''" />
				<view v-if="formData.phone.length > 0" class="clear-btn" @click="formData.phone = ''">
					<text class="clear-icon">✕</text>
				</view>
			</view>

			<!-- 密码 -->
			<view class="field-wrap" :class="{ 'field-focus': focusField === 'password' }">
				<view class="field-icon-box" :class="{ 'icon-active': focusField === 'password' }">
					<text class="field-icon">🔒</text>
				</view>
				<input class="field-input" :password="!showPwd" placeholder="请输入密码"
					placeholder-class="field-placeholder" v-model="formData.password"
					@focus="focusField = 'password'" @blur="focusField = ''" />
				<view class="eye-btn" @click="showPwd = !showPwd">
					<text class="eye-icon">{{ showPwd ? '🙈' : '👁️' }}</text>
				</view>
			</view>

			<!-- 确认密码（注册） -->
			<view v-if="mode === 'register'" class="field-wrap"
				:class="{ 'field-focus': focusField === 'confirm' }">
				<view class="field-icon-box" :class="{ 'icon-active': focusField === 'confirm' }">
					<text class="field-icon">🔐</text>
				</view>
				<input class="field-input" :password="!showPwd" placeholder="再次确认密码"
					placeholder-class="field-placeholder" v-model="formData.confirmPassword"
					@focus="focusField = 'confirm'" @blur="focusField = ''" />
			</view>

			<!-- 验证码（注册） -->
			<view v-if="mode === 'register'" class="field-wrap code-field"
				:class="{ 'field-focus': focusField === 'code' }">
				<view class="field-icon-box" :class="{ 'icon-active': focusField === 'code' }">
					<text class="field-icon">🛡️</text>
				</view>
				<input class="field-input" type="number" maxlength="6" placeholder="短信验证码"
					placeholder-class="field-placeholder" v-model="formData.code" @focus="focusField = 'code'"
					@blur="focusField = ''" />
				<view class="sms-btn" :class="{ 'sms-disabled': isSendingCode }" @click="sendCode">
					<text class="sms-text">{{ codeText }}</text>
				</view>
			</view>

			<!-- 协议勾选 -->
			<view class="agreement-row">
				<view class="check-box" :class="{ 'checked': isAgreed }" @click="isAgreed = !isAgreed">
					<text v-if="isAgreed" class="check-mark">✓</text>
				</view>
				<text class="agree-text">我已阅读并同意</text>
				<text class="agree-link" @click="goAgreement('user')">《用户协议》</text>
				<text class="agree-text">与</text>
				<text class="agree-link" @click="goAgreement('privacy')">《隐私政策》</text>
			</view>

			<!-- 提交按钮 -->
			<button class="submit-btn" :class="{ 'btn-disabled': !canSubmit }" :loading="isLoading"
				@click="handleSubmit">
				{{ mode === 'login' ? '登 录' : '注 册' }}
			</button>

			<!-- 底部辅助链接 -->
			<view class="footer-links">
				<text v-if="mode === 'login'" class="link-text" @click="switchMode('register')">还没有账号？立即注册</text>
				<text v-else class="link-text" @click="switchMode('login')">已有账号？直接登录</text>
				<text v-if="mode === 'login'" class="link-divider">|</text>
				<text v-if="mode === 'login'" class="link-text link-accent" @click="handleForgot">忘记密码</text>
			</view>
		</view>

		<!-- 底部版权 -->
		<text class="copyright">© 2026 MySchedule · 用心记录每一天</text>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue';
	import { setToken } from '@/utils/auth.uts';

	// ===== 状态 =====
	const mode = ref<string>('login');
	const isLoading = ref<boolean>(false);
	const showPwd = ref<boolean>(false);
	const isAgreed = ref<boolean>(false);
	const focusField = ref<string>('');
	const codeText = ref<string>('获取验证码');
	const isSendingCode = ref<boolean>(false);

	const formData = ref({
		phone: '',
		password: '',
		confirmPassword: '',
		code: ''
	});

	// ===== 计算属性 =====
	const canSubmit = computed<boolean>((): boolean => {
		if (!isAgreed.value) return false;
		if (formData.value.phone.length !== 11) return false;
		if (formData.value.password.length < 6) return false;
		if (mode.value === 'register') {
			if (formData.value.password !== formData.value.confirmPassword) return false;
			if (formData.value.code.length !== 6) return false;
		}
		return true;
	});

	// ===== 方法 =====
	const switchMode = (m: string) => {
		mode.value = m;
		formData.value.password = '';
		formData.value.confirmPassword = '';
		formData.value.code = '';
		showPwd.value = false;
	};

	const sendCode = () => {
		if (isSendingCode.value) return;
		if (formData.value.phone.length !== 11) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' });
			return;
		}
		isSendingCode.value = true;
		uni.showToast({ title: '验证码已发送', icon: 'success' });
		let sec = 60;
		codeText.value = sec.toString() + 's';
		const timer = setInterval(() => {
			sec--;
			codeText.value = sec.toString() + 's';
			if (sec <= 0) {
				clearInterval(timer);
				isSendingCode.value = false;
				codeText.value = '获取验证码';
			}
		}, 1000);
	};

	const handleSubmit = () => {
		if (!canSubmit.value) {
			if (!isAgreed.value) {
				uni.showToast({ title: '请先同意用户协议与隐私政策', icon: 'none' });
			} else if (formData.value.phone.length !== 11) {
				uni.showToast({ title: '请输入11位手机号', icon: 'none' });
			} else if (formData.value.password.length < 6) {
				uni.showToast({ title: '密码至少6位', icon: 'none' });
			} else if (mode.value === 'register' && formData.value.password !== formData.value.confirmPassword) {
				uni.showToast({ title: '两次密码不一致', icon: 'none' });
			} else if (mode.value === 'register' && formData.value.code.length !== 6) {
				uni.showToast({ title: '请输入6位验证码', icon: 'none' });
			}
			return;
		}

		isLoading.value = true;
		setTimeout(() => {
			isLoading.value = false;
			setToken('token_' + Date.now().toString());
			uni.showToast({
				title: mode.value === 'login' ? '欢迎回来 ✨' : '注册成功 🎉',
				icon: 'none'
			});
			setTimeout(() => {
				const redirectUrl = uni.getStorageSync('redirect_url') as string;
				uni.removeStorageSync('redirect_url');
				if (redirectUrl !== null && redirectUrl !== undefined && redirectUrl !== '') {
					if (redirectUrl.indexOf('/pages/tab/') !== -1) {
						uni.switchTab({ url: redirectUrl.split('?')[0] });
					} else {
						uni.redirectTo({ url: redirectUrl });
					}
				} else {
					uni.switchTab({ url: '/pages/tab/home/home' });
				}
			}, 800);
		}, 1500);
	};

	const handleForgot = () => {
		uni.showToast({ title: '请联系客服重置密码', icon: 'none' });
	};

	const goAgreement = (type: string) => {
		uni.navigateTo({ url: '/pages/login/agreement?type=' + type });
	};
</script>

<style lang="scss">
	/* ========== 设计令牌 ========== */
	$c-primary: #ED317F;
	$c-primary-dark: #C41E6A;
	$c-primary-light: #FF6BA6;
	$c-bg-start: #FFF0F6;
	$c-bg-end: #FDEEF5;
	$c-card-bg: rgba(255, 255, 255, 0.92);
	$c-text: #2D2D2D;
	$c-text-secondary: #8E8E93;
	$c-border: #E8E8ED;
	$c-border-focus: #ED317F;
	$r-card: 40rpx;
	$r-input: 20rpx;
	$r-btn: 52rpx;

	/* ========== 页面容器 ========== */
	.login-page {
		flex: 1;
		flex-direction: column;
		position: relative;
		overflow: hidden;
	}

	/* ========== 背景层 ========== */
	.bg-layer {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 0;
	}

	.bg-gradient {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(160deg, $c-bg-start 0%, #ffffff 40%, $c-bg-end 100%);
	}

	.orb {
		position: absolute;
		border-radius: 999rpx;
	}

	.orb-1 {
		width: 500rpx;
		height: 500rpx;
		top: -120rpx;
		right: -100rpx;
		background: radial-gradient(circle, rgba(237, 49, 127, 0.12) 0%, transparent 70%);
	}

	.orb-2 {
		width: 360rpx;
		height: 360rpx;
		top: 200rpx;
		left: -80rpx;
		background: radial-gradient(circle, rgba(255, 107, 166, 0.10) 0%, transparent 70%);
	}

	.orb-3 {
		width: 280rpx;
		height: 280rpx;
		bottom: 160rpx;
		right: -40rpx;
		background: radial-gradient(circle, rgba(237, 49, 127, 0.08) 0%, transparent 70%);
	}

	/* ========== Logo 区域 ========== */
	.logo-section {
		align-items: center;
		padding-top: 140rpx;
		padding-bottom: 48rpx;
		z-index: 1;
	}

	.logo-circle {
		width: 120rpx;
		height: 120rpx;
		border-radius: 60rpx;
		background: linear-gradient(135deg, $c-primary 0%, $c-primary-light 100%);
		align-items: center;
		justify-content: center;
		margin-bottom: 24rpx;
		box-shadow: 0 16rpx 40rpx rgba(237, 49, 127, 0.30);
	}

	.logo-emoji {
		font-size: 56rpx;
	}

	.app-title {
		font-size: 48rpx;
		font-weight: 800;
		color: $c-text;
		letter-spacing: 2rpx;
		margin-bottom: 10rpx;
	}

	.app-subtitle {
		font-size: 26rpx;
		color: $c-text-secondary;
		letter-spacing: 1rpx;
	}

	/* ========== 毛玻璃卡片 ========== */
	.glass-card {
		margin: 0 40rpx;
		padding: 44rpx 36rpx 36rpx;
		background-color: $c-card-bg;
		border-radius: $r-card;
		z-index: 1;
		box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.06);
		border-width: 1rpx;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.6);
	}

	/* ========== Tab 切换器 ========== */
	.tab-bar {
		flex-direction: row;
		position: relative;
		margin-bottom: 40rpx;
		background-color: #F5F5F7;
		border-radius: 28rpx;
		padding: 6rpx;
	}

	.tab-track {
		position: absolute;
		top: 6rpx;
		bottom: 6rpx;
		left: 6rpx;
		right: 6rpx;
		flex-direction: row;
	}

	.tab-indicator {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 48%;
		background-color: #ffffff;
		border-radius: 24rpx;
		box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
		transition-property: left;
		transition-duration: 0.3s;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.tab-item {
		flex: 1;
		align-items: center;
		justify-content: center;
		height: 80rpx;
		z-index: 2;
	}

	.tab-label {
		font-size: 28rpx;
		font-weight: 600;
		color: $c-text-secondary;
		transition-property: color;
		transition-duration: 0.3s;
	}

	.tab-label-active {
		color: $c-primary;
		font-weight: 700;
	}

	/* ========== 输入框 ========== */
	.field-wrap {
		flex-direction: row;
		align-items: center;
		height: 100rpx;
		background-color: #F8F8FA;
		border-radius: $r-input;
		padding-left: 24rpx;
		padding-right: 16rpx;
		margin-bottom: 20rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: transparent;
		transition-property: border-color, background-color;
		transition-duration: 0.25s;
	}

	.field-focus {
		background-color: #FFFFFF;
		border-color: $c-border-focus;
		box-shadow: 0 0 0 4rpx rgba(237, 49, 127, 0.08);
	}

	.field-icon-box {
		width: 48rpx;
		align-items: center;
		justify-content: center;
		margin-right: 16rpx;
		opacity: 0.45;
		transition-property: opacity;
		transition-duration: 0.25s;
	}

	.icon-active {
		opacity: 1;
	}

	.field-icon {
		font-size: 30rpx;
	}

	.field-input {
		flex: 1;
		font-size: 30rpx;
		color: $c-text;
		height: 100rpx;
		font-weight: 500;
	}

	.field-placeholder {
		color: #C7C7CC;
		font-weight: 400;
	}

	.clear-btn {
		width: 44rpx;
		height: 44rpx;
		border-radius: 22rpx;
		background-color: #E0E0E5;
		align-items: center;
		justify-content: center;
	}

	.clear-icon {
		font-size: 18rpx;
		color: #ffffff;
		font-weight: bold;
	}

	.eye-btn {
		padding: 12rpx;
	}

	.eye-icon {
		font-size: 28rpx;
		opacity: 0.5;
	}

	/* ========== 验证码按钮 ========== */
	.code-field {
		padding-right: 8rpx;
	}

	.sms-btn {
		background: linear-gradient(135deg, $c-primary 0%, $c-primary-light 100%);
		padding: 14rpx 24rpx;
		border-radius: 16rpx;
	}

	.sms-disabled {
		opacity: 0.45;
	}

	.sms-text {
		font-size: 22rpx;
		color: #ffffff;
		font-weight: 700;
		letter-spacing: 0.5rpx;
	}

	/* ========== 协议行 ========== */
	.agreement-row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		margin-top: 8rpx;
		margin-bottom: 32rpx;
	}

	.check-box {
		width: 30rpx;
		height: 30rpx;
		border-radius: 15rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #D1D1D6;
		margin-right: 10rpx;
		align-items: center;
		justify-content: center;
		transition-property: background-color, border-color;
		transition-duration: 0.2s;
	}

	.checked {
		background-color: $c-primary;
		border-color: $c-primary;
	}

	.check-mark {
		color: #ffffff;
		font-size: 16rpx;
		font-weight: 800;
	}

	.agree-text {
		font-size: 22rpx;
		color: $c-text-secondary;
		line-height: 32rpx;
	}

	.agree-link {
		font-size: 22rpx;
		color: $c-primary;
		line-height: 32rpx;
	}

	/* ========== 提交按钮 ========== */
	.submit-btn {
		height: 100rpx;
		line-height: 100rpx;
		border-radius: $r-btn;
		background: linear-gradient(135deg, $c-primary 0%, $c-primary-light 100%);
		color: #ffffff;
		font-size: 32rpx;
		font-weight: 700;
		letter-spacing: 4rpx;
		text-align: center;
		box-shadow: 0 12rpx 32rpx rgba(237, 49, 127, 0.35);
		border-width: 0;
	}

	.submit-btn:active {
		opacity: 0.88;
		transform: scale(0.98);
	}

	.btn-disabled {
		background: linear-gradient(135deg, #C7C7CC 0%, #D1D1D6 100%);
		box-shadow: none;
	}

	/* ========== 底部链接 ========== */
	.footer-links {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin-top: 28rpx;
	}

	.link-text {
		font-size: 24rpx;
		color: $c-text-secondary;
	}

	.link-accent {
		color: $c-primary;
	}

	.link-divider {
		font-size: 20rpx;
		color: #D1D1D6;
		margin: 0 16rpx;
	}

	/* ========== 版权 ========== */
	.copyright {
		position: absolute;
		bottom: 48rpx;
		width: 750rpx;
		text-align: center;
		font-size: 20rpx;
		color: #C7C7CC;
		letter-spacing: 1rpx;
		z-index: 1;
	}
</style>