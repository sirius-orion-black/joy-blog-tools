<template>
  <view class="page-container">
    <!-- 顶部店铺信息 (固定不滚动，或者随页面滚动看需求，这里模拟截图作为头部) -->
    <view class="header-info">
      <view class="shop-row">
        <image class="avatar" src="/static/logo.png"></image>
        <view class="text-group">
          <text class="shop-name">美猫猫小厨房</text>
          <text class="sub-text">共2人</text>
        </view>
      </view>
      <view class="notice">
        <text class="notice-text">公告：家是爱的地方，好好生活...</text>
      </view>
    </view>

    <!-- 核心点单区域 (左右分栏) -->
    <!-- flex: 1 确保它占据除了头部和底部之外的所有空间 -->
    <view class="menu-area">
      <!-- 左侧分类导航 -->
      <scroll-view class="sidebar" scroll-y>
        <view
          v-for="(item, index) in categories"
          :key="index"
          class="nav-item"
          :class="{ active: currentCategory === item.name }"
          @click="switchCategory(item.name)"
        >
          <text>{{ item.name }}</text>
        </view>
      </scroll-view>

      <!-- 右侧菜品列表 -->
      <scroll-view class="product-list" scroll-y>
        <view class="category-title">{{ currentCategory }}({{ productList.length }})</view>
        <view class="product-item" v-for="(prod, idx) in productList" :key="idx">
          <image class="prod-img" :src="prod.image"></image>
          <view class="prod-info">
            <text class="prod-name">{{ prod.name }}</text>
            <text class="prod-desc">{{ prod.desc }}</text>
            <text class="prod-sales">月销 {{ prod.sales }}</text>
          </view>
          <view class="add-btn">+</view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部购物车栏 (悬浮/固定) -->
    <!-- 这里的逻辑是：它始终存在，但高度和样式会根据 isCartOpen 变化 -->
    <view class="cart-bar" :class="{ 'cart-open': isCartOpen }">
      <!-- 购物车主体部分 -->
      <view class="cart-main" @click="toggleCart">
        <view class="cart-icon-wrapper">
          <!-- 这里可以用 iconfont 或者图片 -->
          <text class="icon">🛒</text>
          <view v-if="totalCount > 0" class="badge">{{ totalCount }}</view>
        </view>
        <view class="price-info">
           <text v-if="totalPrice > 0" class="price">¥{{ totalPrice }}</text>
           <text v-else class="empty-tip">未选购商品</text>
        </view>
        <view class="action-btn" :class="{ disabled: totalPrice === 0 }">
          <text>去结算</text>
        </view>
      </view>

      <!-- 弹出的详细列表 (只有 isCartOpen 为 true 时显示) -->
      <view v-if="isCartOpen" class="cart-detail-popup">
         <text class="clear-cart" @click.stop="clearCart">清空</text>
         <view class="detail-item" v-for="(item, i) in cartList" :key="i">
            <text>{{ item.name }} x {{ item.count }}</text>
         </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue';

// 模拟数据
const categories = [
  { name: '无肉不欢' },
  { name: '靓汤' },
  { name: '青菜' },
  { name: '主食' },
];

const productList = [
  { name: '酸菜炒大肠', desc: '肥肠、酸菜、姜...', sales: 0, image: '/static/food1.jpg' },
  { name: '五花肉辣炒鹿茸菇', desc: '五花肉、干鹿茸菇...', sales: 0, image: '/static/food2.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
  { name: '油豆腐炒肉', desc: '...', sales: 0, image: '/static/food3.jpg' },
];

// 状态管理
const currentCategory = ref<string>('无肉不欢');
const isCartOpen = ref<boolean>(false); // 控制购物车是否展开
const totalCount = ref<number>(0); // 购物车总数
const totalPrice = ref<number>(0); // 总价
const cartList = ref<any[]>([]); // 购物车详情列表

// 方法
const switchCategory = (name: string) => {
  currentCategory.value = name;
};

const toggleCart = () => {
  if (totalCount.value > 0) {
    isCartOpen.value = !isCartOpen.value;
  }
};

const clearCart = () => {
  totalCount.value = 0;
  totalPrice.value = 0;
  cartList.value = [];
  isCartOpen.value = false;
};
</script>

<style scoped>
/* 页面根容器：Flex 纵向布局 */
.page-container {
  display: flex;
  flex-direction: column;
  /* 占满全屏 */
  /* #ifdef H5 */
  height: calc(100vh - 180rpx);
  /* #endif */
  /* #ifndef H5 */
  height: calc(100vh);
  /* #endif */
  background-color: #f5f5f5;
}

