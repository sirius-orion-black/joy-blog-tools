  font-size: 16px;
  font-weight: bold;
}

.action-btn.disabled {
  background-color: #555;
  color: #999;
}

/* 弹出的详情列表 */
.cart-detail-popup {
  flex: 1; /* 占据剩余高度 */
  background-color: #fff;
  padding: 10px;
  overflow-y: auto;
}

.clear-cart {
  float: right;
  color: #666;
  font-size: 12px;
  padding: 5px;
}
</style>