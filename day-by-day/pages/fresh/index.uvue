  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.sub-text {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.notice-text {
  font-size: 12px;
  color: #666;
}

/* 中间菜单区：Flex 1 撑开剩余空间 */
.menu-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden; /* 防止溢出 */
}

