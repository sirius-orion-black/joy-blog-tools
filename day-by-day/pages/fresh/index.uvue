  border-radius: 12px;
  background-color: #e95f5d;
  color: #fff;
  text-align: center;
  line-height: 24px;
  align-self: flex-end; /* 靠下对齐 */
}

/* 底部购物车栏 (关键点) */
.cart-bar {
  position: relative; /* 或者 absolute bottom:0，视具体层级需求而定 */
  z-index: 999;
  background-color: #333;
  /* 默认状态：只显示一行的高度 */
  height: 50px;
  transition: all 0.3s ease; /* 添加过渡动画 */
  display: flex;
  flex-direction: column-reverse; /* 让主栏在下面，详情在上面弹出 */
}

/* 购物车展开时的样式 */
.cart-bar.cart-open {
  height: 200px; /* 展开后的高度 */
  background-color: rgba(0,0,0,0.8); /* 背景变暗一点衬托列表 */
}

.cart-main {
  height: 50px;
  display: flex;
  flex-direction: row;
