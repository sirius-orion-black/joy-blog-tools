.product-list {
  flex: 1;
  height: 100%;
  background-color: #ffffff;
}

.category-title {
  padding: 10px 15px;
  font-size: 14px;
  font-weight: bold;
  color: #333;
}

.product-item {
  display: flex;
  flex-direction: row;
  padding: 10px 15px;
  border-bottom: 1px solid #f9f9f9;
}

.prod-img {
  width: 80px;
  height: 80px;
  border-radius: 4px;
  background-color: #eee;
  margin-right: 10px;
}

.prod-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.prod-name {
  font-size: 15px;
  font-weight: bold;
  color: #333;
  margin-bottom: 4px;
}

.prod-desc {
  font-size: 12px;
  color: #999;
  margin-bottom: 4px;
}

