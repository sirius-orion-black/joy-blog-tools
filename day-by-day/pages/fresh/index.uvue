<template>
	<view class="common-flex-body">
		<!-- 1. 顶部固定 Banner -->
		<view class="fresh-header">
			<!-- 渐变背景 -->
			<view class="header-bg"></view>

			<!-- 右侧几何装饰（纯CSS） -->
			<view class="deco-circle deco-circle-1"></view>
			<view class="deco-circle deco-circle-2"></view>
			<view class="deco-circle deco-circle-3"></view>

			<!-- 头部内容区 -->
			<view class="header-content">
				<!-- 标题行 -->
				<view class="title-row">
					<view class="title-group">
						<text class="page-title">厨房库存</text>
						<text class="page-subtitle">新鲜配菜 · 调料余量一目了然</text>
					</view>
					<!-- 右侧小图标装饰 -->
					<view class="header-icon-badge">
						<text class="header-icon-text">🍳</text>
					</view>
				</view>

				<!-- 实底搜索框（在纯色背景上永远清晰） -->
				<view class="search-bar">
					<view class="search-icon">
						<SvgIcon :svg="searchIcon" :size="24" />
					</view>
					<input class="search-input" type="text" placeholder="搜五花肉、生抽、土豆..."
						placeholder-style="color: #b0b8c4; font-size: 26rpx;" confirm-type="search"
						adjust-position="false" />
				</view>
			</view>
		</view>

		<!-- 2. 悬浮 Tab 栏 (做成胶囊样式，更现代) -->
		<view class="fresh-tab-bar">
			<view class="tab-capsule">
				<view class="tab-item" :class="{ active: currentTab === 0 }" @click="currentTab = 0">
					<text class="tab-text">🥬 配菜</text>
				</view>
				<view class="tab-item" :class="{ active: currentTab === 1 }" @click="currentTab = 1">
					<text class="tab-text">🧂 调料</text>
				</view>
			</view>
		</view>

		<!-- 3. 双列网格滚动区域 -->

		<!-- 配菜网格 -->
		<scroll-view v-if="currentTab === 0" class="fresh-scroll" scroll-y="true">
			<view class="grid-container">
				<view class="grid-card" :class="{ 'out-of-stock': item.stock <= 0 }"
					v-for="(item, index) in sideDishList" :key="index">
					<view v-if="item.stock <= 0" class="sold-out-badge">
						<text class="sold-out-text">缺货</text>
					</view>
					<image class="card-img" :src="item.image" mode="aspectFill"></image>
					<view class="card-content">
						<text class="card-name">{{ item.name }}</text>
						<text class="card-unit">库存单位: {{ item.unit }}</text>

						<!-- 底部库存调节区 -->
						<view class="card-footer">
							<text class="stock-label">余量</text>
							<view class="stepper-mini">
								<view class="step-btn-sm minus" :class="{ 'disabled': item.stock <= 0 }"
									@click="changeStock(item, -1)">
									<text class="step-text-sm">-</text>
								</view>
								<text class="stock-num-sm">{{ item.stock }}</text>
								<view class="step-btn-sm plus" @click="changeStock(item, 1)">
									<text class="step-text-sm">+</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
			<view style="height: 40rpx;"></view>
		</scroll-view>

		<!-- 调料网格 -->
		<scroll-view v-if="currentTab === 1" class="fresh-scroll" scroll-y="true">
			<view class="grid-container">
				<view class="grid-card" :class="{ 'out-of-stock': item.stock <= 0 }"
					v-for="(item, index) in seasoningList" :key="index">
					<view v-if="item.stock <= 0" class="sold-out-badge">
						<text class="sold-out-text">缺货</text>
					</view>
					<image class="card-img" :src="item.image" mode="aspectFill"></image>
					<view class="card-content">
						<text class="card-name">{{ item.name }}</text>
						<text class="card-unit">库存单位: {{ item.unit }}</text>

						<view class="card-footer">
							<text class="stock-label">余量</text>
							<view class="stepper-mini">
								<view class="step-btn-sm minus" :class="{ 'disabled': item.stock <= 0 }"
									@click="changeStock(item, -1)">
									<text class="step-text-sm">-</text>
								</view>
								<text class="stock-num-sm">{{ item.stock }}</text>
								<view class="step-btn-sm plus" @click="changeStock(item, 1)">
									<text class="step-text-sm">+</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
			<view style="height: 40rpx;"></view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { ref } from 'vue';

	import SvgIcon from '@/components/SvgIcon.uvue'

	import { searchIcon } from '@/utils/svg/kitchenSvg'

	interface IngredientItem {
		name : string;
		image : string;
		unit : string;
		stock : number;
	}

	const currentTab = ref(0);

	// 模拟更多数据以展示网格效果
	const sideDishList = ref<IngredientItem[]>([
		{ name: '精品五花肉', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '份', stock: 12 },
		{ name: '农家小青菜', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '把', stock: 8 },
		{ name: '手工嫩豆腐', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '块', stock: 5 },
		{ name: '鲜切土豆片', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '盘', stock: 0 },
		{ name: '黑木耳', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '份', stock: 6 },
		{ name: '金针菇', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '包', stock: 10 },
	]);

	const seasoningList = ref<IngredientItem[]>([
		{ name: '特级生抽', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '瓶', stock: 20 },
		{ name: '陈年老醋', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '瓶', stock: 15 },
		{ name: '食用盐', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '袋', stock: 30 },
		{ name: '白胡椒粉', image: 'https://img.yzcdn.cn/vant/cat.jpeg', unit: '罐', stock: 3 },
	]);

	const changeStock = (item : IngredientItem, delta : number) => {
		const newStock = item.stock + delta;
		if (newStock < 0) return;
		item.stock = newStock;
	};
</script>

<style lang="scss">
	.common-flex-body {

		/* --- 顶部 Banner --- */
		.fresh-header {
			/* #ifndef H5 */
			padding-top: 25rpx;
			/* #endif */
			position: relative;
			width: 750rpx;
			/* #ifdef H5 */
			height: 380rpx;
			/* #endif */
			/* #ifndef H5 */
			height: 405rpx;
			/* #endif */
			overflow: hidden;

			/* 渐变背景 */
			.header-bg {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-image: linear-gradient(135deg, $select-color, $bg-no-color);
			}

			/* 几何装饰圆 - 纯CSS实现 */
			.deco-circle {
				position: absolute;
				border-radius: 50%;
				background-color: rgba(255, 255, 255, 0.08);
			}

			.deco-circle-1 {
				width: 320rpx;
				height: 320rpx;
				right: -60rpx;
				top: -80rpx;
			}

			.deco-circle-2 {
				width: 200rpx;
				height: 200rpx;
				right: 80rpx;
				bottom: -40rpx;
				background-color: rgba(255, 255, 255, 0.06);
			}

			.deco-circle-3 {
				width: 120rpx;
				height: 120rpx;
				left: 60rpx;
				bottom: 40rpx;
				background-color: rgba(255, 255, 255, 0.05);
			}

			/* 头部内容 */
			.header-content {
				position: relative;
				z-index: 5;
				padding: 0 32rpx;
				height: 380rpx;
				flex-direction: column;
				justify-content: center;

				/* 标题行 */
				.title-row {
					flex-direction: row;
					align-items: flex-start;
					justify-content: space-between;
					margin-bottom: 28rpx;

					.title-group {
						flex: 1;
						flex-direction: column;

						.page-title {
							font-size: 36rpx;
							font-weight: 800;
							color: #ffffff;
							margin-bottom: 8rpx;
						}

						.page-subtitle {
							font-size: 24rpx;
							color: rgba(255, 255, 255, 0.75);
							font-weight: 400;
						}
					}

					/* 右侧图标徽章 */
					.header-icon-badge {
						width: 80rpx;
						height: 80rpx;
						border-radius: 24rpx;
						background-color: rgba(255, 255, 255, 0.18);
						align-items: center;
						justify-content: center;
						margin-left: 20rpx;
						/* #ifndef H5 */
						position: absolute;
						right: 170rpx;
						top: 0rpx;
						/* #endif */

						.header-icon-text {
							font-size: 40rpx;
						}
					}
				}

				/* 实底搜索框 - 白色实底在深色渐变上对比度满分 */
				.search-bar {
					flex-direction: row;
					align-items: center;
					background-color: #ffffff;
					border-radius: 999rpx;
					padding: 0 28rpx;
					height: 80rpx;

					.search-icon {
						font-size: 30rpx;
						margin-right: 16rpx;
						color: #bbb;
					}

					.search-input {
						flex: 1;
						font-size: 28rpx;
						color: $unify-black;
						height: 80rpx;
					}
				}
			}
		}

		/* --- 悬浮胶囊 Tab --- */
		.fresh-tab-bar {
			padding: 20rpx 30rpx;
			margin-top: -50rpx;
			z-index: 10;

			.tab-capsule {
				flex-direction: row;
				background-color: $unify-white;
				border-radius: 40rpx;
				padding: 8rpx;
				/* UniApp X 阴影支持有限，可用边框代替 */
				border-width: 1rpx;
				border-color: #e0e0e0;

				.tab-item {
					flex: 1;
					align-items: center;
					justify-content: center;
					padding: 16rpx 0;
					border-radius: 32rpx;
					transition: all 0.3s;

					.tab-text {
						font-size: 28rpx;
						color: $unify-black;
						font-weight: bold;
					}

					&.active {
						background-color: $bg-no-color;

						.tab-text {
							color: $select-color;
						}
					}
				}

			}
		}

		/* --- 双列网格布局 --- */
		.fresh-scroll {
			flex: 1;
			padding: 0 20rpx;

			.grid-container {
				flex-direction: row;
				flex-wrap: wrap;
				justify-content: space-between;

				.grid-card {
					width: 345rpx;
					/* (750 - 20*2 - 20) / 2 ≈ 345 */
					background-color: $unify-white;
					border-radius: 24rpx;
					margin-bottom: 20rpx;
					overflow: hidden;

					/* 确保图片圆角生效 */
					/* 简单的点击反馈 */
					&:active {
						transform: scale(0.98);
						opacity: 0.9;
					}

					&.out-of-stock {
						opacity: 0.65;
					}

					.sold-out-badge {
						position: absolute;
						top: 16rpx;
						right: 16rpx;
						background-color: $bg-color-oblack;
						border-radius: 16rpx;
						padding: 4rpx 14rpx;
						z-index: 5;

						.sold-out-text {
							font-size: 20rpx;
							color: #ffffff;
							font-weight: bold;
						}
					}



					.card-img {
						width: 345rpx;
						height: 260rpx;
						/* 图片高度大一点，更好看 */
						background-color: $bg-color-grey;
					}

					.card-content {
						padding: 20rpx;

						.card-name {
							font-size: 28rpx;
							font-weight: bold;
							color: $unify-black;
							lines: 1;
							text-overflow: ellipsis;
							margin-bottom: 8rpx;
						}

						.card-unit {
							font-size: 22rpx;
							color: $unify-grey;
							margin-bottom: 20rpx;
						}

						/* --- 底部库存调节 (紧凑版) --- */
						.card-footer {
							flex-direction: row;
							justify-content: space-between;
							align-items: center;
							border-top-width: 1rpx;
							border-top-color: $border-color-grey;
							padding-top: 16rpx;

							.stock-label {
								font-size: 22rpx;
								color: $unify-grey;
							}

							.stepper-mini {
								flex-direction: row;
								align-items: center;
								background-color: $bg-color-grey;
								border-radius: 20rpx;
								padding: 2rpx;

								.step-btn-sm {
									width: 44rpx;
									height: 44rpx;
									border-radius: 22rpx;
									align-items: center;
									justify-content: center;

									&.minus {
										background-color: transparent;
									}

									&.plus {
										background-color: $select-color;
									}

									&.disabled {
										opacity: 0.3;
									}

									.step-text-sm {
										font-size: 28rpx;
										font-weight: bold;
										line-height: 44rpx;
									}
								}

								.minus .step-text-sm {
									color: #999;
								}

								.plus .step-text-sm {
									color: #fff;
								}

								.stock-num-sm {
									font-size: 26rpx;
									font-weight: bold;
									color: $unify-black;
									min-width: 50rpx;
									text-align: center;
								}
							}
						}
					}
				}
			}
		}
	}
</style>