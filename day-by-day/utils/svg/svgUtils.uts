
/**
 * 将 SVG 字符串中的 currentColor 替换为指定颜色
 * @param svgString 原始 SVG 字符串
 * @param color 目标颜色值 (如 '#FF0000')
 */
export function replaceSvgColor(svgString: string, color: string): string {
  if (!svgString || !color) return svgString
  
  // 替换 fill="currentColor" 和 stroke="currentColor"
  // 使用全局正则忽略大小写
  let processed = svgString.replace(/fill\s*=\s*["']currentColor["']/gi, `fill="${color}"`)
                           .replace(/stroke\s*=\s*["']currentColor["']/gi, `stroke="${color}"`)
  
  return processed
}

/**
 * 将 SVG 字符串转换为 UTF-8 字节数组
 */
function stringToUtf8Bytes(str: string): number[] {
  const bytes: number[] = []
  for (let i = 0; i < str.length; i++) {
    let charCode = str.charCodeAt(i)
    if (charCode < 0x80) {
      bytes.push(charCode)
    } else if (charCode < 0x800) {
      bytes.push(0xc0 | (charCode >> 6))
      bytes.push(0x80 | (charCode & 0x3f))
    } else if (charCode < 0xd800 || charCode >= 0xe000) {
      bytes.push(0xe0 | (charCode >> 12))
      bytes.push(0x80 | ((charCode >> 6) & 0x3f))
      bytes.push(0x80 | (charCode & 0x3f))
    } else {
      i++
      charCode = 0x10000 + (((charCode & 0x3ff) << 10) | (str.charCodeAt(i) & 0x3ff))
      bytes.push(0xf0 | (charCode >> 18))
      bytes.push(0x80 | ((charCode >> 12) & 0x3f))
      bytes.push(0x80 | ((charCode >> 6) & 0x3f))
      bytes.push(0x80 | (charCode & 0x3f))
    }
  }
  return bytes
}

/**
 * 将 SVG 字符串转换为 Base64 Data URL
 */
export function svgToBase64(svgString: string): string {
  if (!svgString) return ''
  
  let cleaned = svgString
    .replace(/<!--[\s\S]*?-->/g, '') // 移除注释
    .replace(/\s{2,}/g, ' ')         // 压缩多余空白
    .trim()

  const utf8Bytes = stringToUtf8Bytes(cleaned)
  const buffer = new Uint8Array(utf8Bytes).buffer.slice(0)
  const base64 = uni.arrayBufferToBase64((buffer as ArrayBuffer))

  return `data:image/svg+xml;base64,${base64}`
}
