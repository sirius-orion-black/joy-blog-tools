<script lang="uts">
	import { checkAuth, isLoggedIn } from '@/utils/auth.uts';

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	const LOGIN_URL = '/pages/login/login'

	export default {
		onLaunch: function () {
			initLocale()
			console.log('App Launch')

			// #ifdef APP-ANDROID || APP-HARMONY
			setupDoubleBackExit()
			// #endif

			setupAuthGuard()
			setupRouteInterceptor()
		},

		onShow: function () {
			console.log('App Show')
		},
		onHide: function () {
			console.log('App Hide')
		}
	}

	// ========== 初始化语言 ==========
	function initLocale() {
		const lang = uni.getStorageSync('lang') || 'zh-Hans'
		console.log('语言是啥呀', lang)
		uni.setLocale(lang)
	}

	// ========== 双击返回退出应用 ==========
	// #ifdef APP-ANDROID || APP-HARMONY
	function setupDoubleBackExit() {
		onLastPageBackPress(() => {
			console.log('App LastPageBackPress')
			const now = Date.now()

			if (firstBackTime == 0 || now - firstBackTime >= 2000) {
				firstBackTime = now
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				return
			}

			uni.exit()
		})

		onExit(() => {
			console.log('App Exit')
		})
	}
	// #endif

	// ========== 冷启动鉴权 ==========
	function setupAuthGuard() {
		if (isLoggedIn()) return

		console.warn('[Auth] 冷启动未登录，跳转登录页')
		setTimeout(() => {
			uni.navigateTo({ url: LOGIN_URL })
		}, 300)
	}

	// ========== 路由拦截器（兜底） ==========
	function setupRouteInterceptor() {
		const routeMethods : string[] = ['navigateTo', 'redirectTo', 'reLaunch']

		for (let i = 0; i < routeMethods.length; i++) {
			const method = routeMethods[i]
			uni.addInterceptor(method, {
				invoke(args : any) : any {
					const targetUrl = args.url as string

					if (checkAuth(targetUrl)) return args

					console.warn('[Auth] 未登录，拦截: ' + targetUrl)
					saveRedirectUrl(targetUrl)
					uni.navigateTo({ url: LOGIN_URL })
					return false
				},
				fail(err : any) {
					console.error('路由跳转失败', err)
				}
			})
		}
	}

	/** 保存回跳地址（排除登录页本身） */
	function saveRedirectUrl(url : string) {
		const cleanUrl = url.split('?')[0]
		if (cleanUrl === LOGIN_URL) return
		uni.setStorageSync('redirect_url', url)
	}
</script>

<style lang="scss">
	@import '@/static/styles/reset.scss';
	@import '@/static/styles/common.scss'
</style>