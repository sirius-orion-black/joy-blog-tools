import { post, get, upload, type ApiResponse, type RequestOptions } from '@/utils/request.uts';

import { SizeItem, SuitItem } from '@/types/photoType';

/** 获取证件照规格 */
export function getSizes() : Promise<ApiResponse<SizeItem[]>> {
	return get<SizeItem[]>('day/id/photo/sizes', {} as UTSJSONObject, {
		autoToast: false
	} as RequestOptions);
}

/** 获取服装 */
export function getSuits() : Promise<ApiResponse<SuitItem[]>> {
	return get<SuitItem[]>('day/id/photo/suits', {} as UTSJSONObject, {
		autoToast: false
	} as RequestOptions);
}

/** 预览 */
export function preview(filePath : string, type : string, platform : string) : Promise<ApiResponse<UTSJSONObject>> {
	return upload<UTSJSONObject>('day/id/photo/preview', filePath,
		{ type: type, platform: platform } as UTSJSONObject, {
			autoToast: false
		} as RequestOptions);
}
/** 换衣服 */
export function changeSuit(params:UTSJSONObject) : Promise<ApiResponse<UTSJSONObject>> {
	return post<UTSJSONObject>('day/id/photo/changeSuit', params, {
		autoToast: false
	} as RequestOptions);
}

/** 制作证件照 */
export function process(params:UTSJSONObject) : Promise<ApiResponse<UTSJSONObject>> {
	return post<UTSJSONObject>('day/id/photo/process', params, {
		autoToast: false
	} as RequestOptions);
}